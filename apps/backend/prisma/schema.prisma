generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Deck {
  id        Int      @id @default(autoincrement())
  name      String
  cards     Card[]
  rooms     Room[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("deck")
}

model Card {
  id          Int          @id @default(autoincrement())
  value       String
  deckId      Int          @map("deck_id")
  deck        Deck         @relation(fields: [deckId], references: [id])
  estimations Estimation[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("card")
}

model Room {
  id             Int         @id @default(autoincrement())
  uuid           String      @unique @default(uuid())
  title          String
  description    String?
  deckId         Int         @map("deck_id")
  deck           Deck        @relation(fields: [deckId], references: [id])
  selectedTaskId Int?        @map("selected_task_id")
  selectedTask   Task?       @relation("SelectedTask", fields: [selectedTaskId], references: [id])
  tasks          Task[]      @relation("RoomTasks")
  guestUsers     GuestUser[]
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("room")
}

model Task {
  id           Int          @id @default(autoincrement())
  title        String
  roomId       Int          @map("room_id")
  room         Room         @relation("RoomTasks", fields: [roomId], references: [id])
  estimationId Int?         @unique @map("estimation_id")
  estimation   Estimation?  @relation("FinalEstimation", fields: [estimationId], references: [id])
  estimations  Estimation[] @relation("TaskEstimations")
  selectedBy   Room[]       @relation("SelectedTask")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@map("task")
}

model Estimation {
  id           Int       @id @default(autoincrement())
  cardId       Int       @map("card_id")
  card         Card      @relation(fields: [cardId], references: [id])
  taskId       Int?      @map("task_id")
  task         Task?     @relation("TaskEstimations", fields: [taskId], references: [id])
  finalForTask Task?     @relation("FinalEstimation")
  guestUserId  Int       @map("guest_user_id")
  guestUser    GuestUser @relation(fields: [guestUserId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("estimation")
}

model GuestUser {
  id          Int          @id @default(autoincrement())
  name        String
  roomId      Int          @map("room_id")
  room        Room         @relation(fields: [roomId], references: [id])
  spectator   Boolean      @default(false)
  estimations Estimation[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("guest_user")
}
